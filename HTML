        let url = HOUSE_URLS[Math.min(tier - 1, 5)];
        
        let isLoaded = false;
        
        gltfLoader.load(url, (gltf) => {
            isLoaded = true;
            const model = gltf.scene;
            
            // Texture mapping
            model.traverse((child) => {
                if (child.isMesh && child.material) {
                    child.material = new THREE.MeshStandardMaterial({ map: houseTexture, roughness: 0.8 });
                }
            });

            // Force scale to 1 first
            model.scale.set(1, 1, 1);

            // Strict Box3 Scaling (3x3 max)
            const box = new THREE.Box3().setFromObject(model);
            const size = box.getSize(new THREE.Vector3());
            const maxDim = Math.max(size.x, size.z);
            
            if (maxDim > 0) {
                const scale = 2.8 / maxDim; // Safely fits inside 3.0 width
                model.scale.set(scale, scale, scale);
            } else {
                scene.remove(model);
                buildFallbackHouse(tier);
                return;
            }
            
            // Recompute bounding box and set proper Y anchor to 0
            const scaledBox = new THREE.Box3().setFromObject(model);
            const center = scaledBox.getCenter(new THREE.Vector3());
            
            const targetX = 3 - GRID_SIZE/2 + 0.5;
            const targetZ = 3 - GRID_SIZE/2 + 0.5;
            
            model.position.x += (targetX - center.x);
            model.position.z += (targetZ - center.z);
            model.position.y += (0 - scaledBox.min.y); // Anchor bottom to ground
            
            scene.add(model);
            currentHouseMesh = model;
        }, undefined, (err) => { 
            console.error("House failed to load:", err);
            buildFallbackHouse(tier); 
        });
        
        // Timeout Fallback
        setTimeout(() => {
            if(!isLoaded && !currentHouseMesh) {
                console.warn("House load timeout. Using fallback.");
                buildFallbackHouse(tier);
            }
        }, 4000);
    }
    
