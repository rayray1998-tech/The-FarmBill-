    function placeAnimal(col, row, type) {
      const startX = col - GRID_SIZE/2 + 0.5; 
      const startZ = row - GRID_SIZE/2 + 0.5;
      
      const requestedAnimalName = type.replace('ANIM_', ''); 
      const animalInfo = animalData.find(a => a.name === requestedAnimalName); 
      if (!animalInfo) return;
      
      const pendingData = { col, row, type }; 
      pendingAnimals.push(pendingData);
      
      gltfLoader.load(animalInfo.url, function(gltf) {
        const model = gltf.scene;
        
        // FIX: Proper GLTF Texture mapping for animals
        model.traverse((child) => {
            if (child.isMesh && child.material) {
                child.material = new THREE.MeshStandardMaterial({ map: animalTexture, roughness: 0.8 });
            }
        });
        
        const box = new THREE.Box3().setFromObject(model); 
        const size = new THREE.Vector3(); 
        box.getSize(size);
        
        const maxDim = Math.max(size.x, size.y, size.z); 
        if (maxDim > 0) { 
            const scaleFactor = 0.8 / maxDim; 
            model.scale.set(scaleFactor, scaleFactor, scaleFactor); 
        }
        
        const scaledBox = new THREE.Box3().setFromObject(model); 
        const baseY = -scaledBox.min.y; 
        
        model.position.set(startX, baseY, startZ); 
        scene.add(model);
        
        animals.push({ 
            mesh: model, targetX: startX, targetZ: startZ, type: type, col: col, row: row, baseY: baseY, 
            speed: 1.0 + (Math.random() * 0.5), lastProductTime: undefined, readyToMilk: false, state: 'moving' 
        });
        
        const idx = pendingAnimals.indexOf(pendingData); 
        if (idx > -1) pendingAnimals.splice(idx, 1);
      });
    }

    const raycaster = new THREE.Raycaster(); 
    const mouse = new THREE.Vector2();
    
    window.addEventListener('pointermove', (event) => {
      if (isVisiting || gameMode !== 'FARMING' || document.getElementById('leaderboard-modal').style.display === 'flex' || document.getElementById('quests-modal').style.display === 'flex' || fishingActive) { 
          highlightMesh.visible = false; 
          return; 
      }
      mouse.x = (event.clientX / window.innerWidth) * 2 - 1; 
      mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;
      
      raycaster.setFromCamera(mouse, camera); 
      const intersects = raycaster.intersectObjects(interactableObjects, true);
      
      if (isEditMode) {
          highlightMesh.visible = false; 
          hoveredBuilding = null;
          
          if (movingBuilding) {
             if (intersects.length > 0 && intersects[0].object === farmBase) {
                 let size = getItemSize(movingBuilding.type); 
                 let col = Math.floor(intersects[0].point.x - (size.w-1)*0.5) + (GRID_SIZE / 2); 
                 let row = Math.floor(intersects[0].point.z - (size.h-1)*0.5) + (GRID_SIZE / 2);
                 if (col >= 0 && col + size.w <= GRID_SIZE && row >= 0 && row + size.h <= GRID_SIZE) { 
                     highlightMesh.visible = true; 
                     highlightMesh.scale.set(size.w, 1, size.h); 
                     highlightMesh.position.set(col - GRID_SIZE/2 + size.w/2, 0.02, row - GRID_SIZE/2 + size.h/2); 
                     highlightMesh.material.color.setHex(canPlaceItem(col, row, size.w, size.h) ? 0x0000ff : 0xff0000); 
                 }
             }
          } else {
              for (let i=0; i<intersects.length; i++) {
                  let p = intersects[i].object.parent;
                  while(p && p !== scene) { 
                      if (p.userData && p.userData.isBuilding) { 
                          hoveredBuilding = p.userData.ref; 
                          document.body.style.cursor = 'pointer'; 
                          return; 
                      } 
                      p = p.parent; 
                  }
              }
              document.body.style.cursor = 'default';
          }
          return;
      }
      
      if (intersects.length > 0 && intersects[0].object === farmBase) {
        let size = getItemSize(currentTool); 
        let col = Math.floor(intersects[0].point.x - (size.w-1)*0.5) + (GRID_SIZE / 2); 
        let row = Math.floor(intersects[0].point.z - (size.h-1)*0.5) + (GRID_SIZE / 2);
        if (col >= 0 && col + size.w <= GRID_SIZE && row >= 0 && row + size.h <= GRID_SIZE) {
          highlightMesh.visible = true; 
          highlightMesh.scale.set(size.w, 1, size.h); 
          highlightMesh.position.set(col - GRID_SIZE/2 + size.w/2, 0.02, row - GRID_SIZE/2 + size.h/2); 
          if (currentTool.startsWith('ANIM')) {
              highlightMesh.material.color.setHex(farmGrid[col][row] === 0 ? 0x00ff00 : 0xff0000);
          } else {
              highlightMesh.material.color.setHex(canPlaceItem(col, row, size.w, size.h) ? 0x00ff00 : 0xff0000); 
          }
        } else {
            highlightMesh.visible = false;
        }
      } else {
          highlightMesh.visible = false;
      }
    });

    window.addEventListener('pointerdown', (e) => {
      if (e.target.closest('#hud-top') || e.target.closest('#toolbar-container') || document.getElementById('leaderboard-modal').style.display === 'flex' || document.getElementById('quests-modal').style.display === 'flex' || fishingActive) return;
      if (e.target.closest('#edit-popup') || e.target.closest('#btn-edit-mode')) return;
      if (isVisiting || gameMode !== 'FARMING') return;
      
      raycaster.setFromCamera(mouse, camera);
      
      if (isEditMode) {
          document.getElementById('edit-popup').style.display = 'none';
          if (movingBuilding) {
              const intersects = raycaster.intersectObjects([farmBase]);
              if (intersects.length > 0) {
                 let size = getItemSize(movingBuilding.type); 
                 let col = Math.floor(intersects[0].point.x - (size.w-1)*0.5) + (GRID_SIZE / 2); 
                 let row = Math.floor(intersects[0].point.z - (size.h-1)*0.5) + (GRID_SIZE / 2);
                 if (canPlaceItem(col, row, size.w, size.h)) {
                     if (statsData.coins >= 50) {
                         statsData.coins -= 50; 
                         occupyGrid(col, row, size.w, size.h, movingBuilding.isDecor ? 30 : 10); 
                         movingBuilding.col = col; 
                         movingBuilding.row = row;
                         movingBuilding.group.position.set(col - GRID_SIZE/2 + size.w/2, movingBuilding.group.position.y, row - GRID_SIZE/2 + size.h/2);
                         movingBuilding = null; 
                         updateHUD(); 
                         syncDirty = true; 
                         spawnDust(col - GRID_SIZE/2 + size.w/2, row - GRID_SIZE/2 + size.h/2); 
                         playSound('coin');
                     } else { 
                         showNotification("Not enough coins!", "#ff4433"); 
                         occupyGrid(movingBuilding.col, movingBuilding.row, size.w, size.h, movingBuilding.isDecor ? 30 : 10); 
                         movingBuilding = null; 
                     }
                 }
              }
          } else if (hoveredBuilding) { 
              document.getElementById('edit-popup').style.left = e.clientX + 'px'; 
              document.getElementById('edit-popup').style.top = e.clientY + 'px'; 
              document.getElementById('edit-popup').style.display = 'flex'; 
          }
          return;
      }
      
      if (!highlightMesh.visible) {
          const intersectsDecor = raycaster.intersectObjects(interactableObjects, true);
          for(let i=0; i<intersectsDecor.length; i++) {
              let p = intersectsDecor[i].object.parent;
              while(p && p !== scene) {
                  if(p.userData && p.userData.ref && p.userData.ref.type === 'DECOR_FISH_POND') {
                      let dist = new THREE.Vector2(playerCharacter.group.position.x - p.position.x, playerCharacter.group.position.z - p.position.z).length();
                      if(dist < 3.0) startFishing();
                      else showNotification("Get closer to fish!", "#ffcc00");
                      return;
                  }
                  p = p.parent;
              }
          }
          return;
      }
      
      const intersects = raycaster.intersectObjects([farmBase]);
      
      if (intersects.length > 0) {
        let size = getItemSize(currentTool); 
        let col = Math.floor(intersects[0].point.x - (size.w-1)*0.5) + (GRID_SIZE / 2); 
        let row = Math.floor(intersects[0].point.z - (size.h-1)*0.5) + (GRID_SIZE / 2);
        
        if (col < 0 || col + size.w > GRID_SIZE || row < 0 || row + size.h > GRID_SIZE) return;

        const existingCrop = crops.find(c => c.col === col && c.row === row);
        if (existingCrop && existingCrop.isDead) {
          if (statsData.energy >= 1) { 
              statsData.energy -= 1; 
              existingCrop.destroy(); 
              crops.splice(crops.indexOf(existingCrop), 1); 
              farmGrid[col][row] = 0; 
              updateHUD(); 
              syncDirty = true; 
              spawnDust(col - GRID_SIZE/2 + 0.5, row - GRID_SIZE/2 + 0.5); 
              showFloatingText("Cleared!", "#fff", col - GRID_SIZE/2 + 0.5, row - GRID_SIZE/2 + 0.5); 
          } else {
              showNotification("Out of Energy!", "#ff4433");
          }
          return;
        }

        let conf = ITEM_CONFIG[currentTool] || ITEM_CONFIG['DEFAULT_ANIM'];
        
        if (currentTool.startsWith('CROP')) {
          if (canPlaceItem(col, row, 1, 1)) {
            if (statsData.coins >= conf.cost) {
              if (statsData.energy < 1) { showNotification("Out of Energy!", "#ff4433"); return; }
              statsData.coins -= conf.cost; 
              statsData.energy -= 1; 
              farmGrid[col][row] = 1; 
              crops.push(new Crop({ col, row, type: currentTool, scale: 0.1 })); 
              updateHUD(); 
              syncDirty = true; 
              spawnDust(col - GRID_SIZE/2 + 0.5, row - GRID_SIZE/2 + 0.5);
            } else {
                showNotification("Not Enough Coins!", "#ff4433");
            }
          }
        } else if (currentTool.startsWith('BUILD')) {
          if (canPlaceItem(col, row, size.w, size.h)) {
            if (statsData.coins >= conf.cost) {
              if (statsData.energy < 1) { showNotification("Out of Energy!", "#ff4433"); return; }
              statsData.coins -= conf.cost; 
              statsData.energy -= 1; 
              placeBuilding(col, row, currentTool); 
              updateHUD(); 
              syncDirty = true; 
              highlightMesh.material.color.setHex(0xff0000); 
              spawnDust(col - GRID_SIZE/2 + size.w/2, row - GRID_SIZE/2 + size.h/2);
            } else {
                showNotification("Not Enough Coins!", "#ff4433");
            }
          }
        } else if (currentTool.startsWith('ANIM')) {
           if (canPlaceItem(col, row, 1, 1)) {
             if (statsData.coins >= conf.cost) {
                if (statsData.energy < 1) { showNotification("Out of Energy!", "#ff4433"); return; }
                statsData.coins -= conf.cost; 
                statsData.energy -= 1; 
                placeAnimal(col, row, currentTool); 
                updateHUD(); 
                syncDirty = true; 
                spawnDust(col - GRID_SIZE/2 + 0.5, row - GRID_SIZE/2 + 0.5);
             } else {
                 showNotification("Not Enough Coins!", "#ff4433");
             }
           }
        } else if (currentTool.startsWith('DECOR')) {
           if (canPlaceItem(col, row, size.w, size.h)) {
             if (statsData.coins >= conf.cost) {
                statsData.coins -= conf.cost; 
                placeDecor(col, row, currentTool); 
                updateHUD(); 
                syncDirty = true; 
                spawnDust(col - GRID_SIZE/2 + size.w/2, row - GRID_SIZE/2 + size.h/2);
             } else {
                 showNotification("Not Enough Coins!", "#ff4433");
             }
           }
        }
        if (syncDirty) updateSyncUI('Unsaved Changes...', '#ffcc00');
      }
    });

    function clearScene() {
      crops.forEach(c => c.destroy()); 
      crops.length = 0;
      buildings.forEach(b => { scene.remove(b.group); let idx = interactableObjects.indexOf(b.group); if(idx>-1) interactableObjects.splice(idx,1); }); 
      buildings.length = 0;
      decorations.forEach(d => { scene.remove(d.group); let idx = interactableObjects.indexOf(d.group); if(idx>-1) interactableObjects.splice(idx,1); }); 
      decorations.length = 0;
      animals.forEach(a => scene.remove(a.mesh)); 
      animals.length = 0;
      drops.forEach(d => scene.remove(d.mesh)); 
      drops.length = 0;
      
      pendingAnimals.length = 0; 
      xmasLights.length = 0; 
      animatedPonds.length = 0;
      
      farmGrid = Array.from({ length: GRID_SIZE }, () => Array(GRID_SIZE).fill(0));
      for(let c=2; c<=4; c++) { 
          for(let r=2; r<=4; r++) { 
              farmGrid[c][r] = 20; 
          } 
      }
    }

    function buildFarm(parsedData, readOnly) {
      clearScene();
      avatarData = Object.assign({ hairStyle: 'short', hairColor: '#4a3018', clothesColor: '#2266cc', activeChar: 'default', unlocked: ['default'] }, parsedData.avatar);
      statsData = Object.assign({ coins: 200, level: 1, xp: 0, energy: 50, quests: [], inventory: {} }, parsedData.stats);
      farmName = parsedData.farmName || (readOnly ? "Neighbor's Farm" : "My Farm");
      houseTier = parsedData.houseTier || 1;
      
      document.getElementById('farm-name-overlay').innerText = farmName; 
      document.getElementById('ui-farm-name-input').value = readOnly ? "" : farmName;
      
      loadHouseModel(houseTier);
      
      if (!playerCharacter) playerCharacter = new PlayerCharacter(); 
      playerCharacter.updateVisuals();
      
      if (parsedData.crops) parsedData.crops.forEach(d => { farmGrid[d.col][d.row] = 1; crops.push(new Crop(d)); });
      if (parsedData.buildings) parsedData.buildings.forEach(d => placeBuilding(d.col, d.row, d.type));
      if (parsedData.decorations) parsedData.decorations.forEach(d => placeDecor(d.col, d.row, d.type));
      if (parsedData.animals) parsedData.animals.forEach(d => placeAnimal(d.col, d.row, d.type));
      
      isVisiting = readOnly; 
      updateHUD();
      
      if (isVisiting) {
        document.getElementById('toolbar-container').style.display = 'none'; 
        document.getElementById('neighbor-bar-wrapper').style.display = 'none'; 
        document.getElementById('return-btn').style.display = 'block'; 
        document.getElementById('read-only-badge').style.display = 'block'; 
        highlightMesh.visible = false; 
        playerCharacter.group.visible = false;
        document.getElementById('farm-name-ui').style.display = 'none'; 
        document.getElementById('btn-leaderboard').style.display = 'none'; 
        document.getElementById('btn-upgrade-house').style.display = 'none'; 
        document.getElementById('btn-edit-mode').style.display = 'none'; 
        document.getElementById('btn-quests-ui').style.display = 'none';
      } else {
        document.getElementById('toolbar-container').style.display = 'flex'; 
        document.getElementById('neighbor-bar-wrapper').style.display = 'flex'; 
        document.getElementById('return-btn').style.display = 'none'; 
        document.getElementById('read-only-badge').style.display = 'none'; 
        playerCharacter.group.visible = true;
        document.getElementById('farm-name-ui').style.display = 'flex'; 
        document.getElementById('btn-leaderboard').style.display = 'block'; 
        document.getElementById('btn-upgrade-house').style.display = 'block'; 
        document.getElementById('btn-edit-mode').style.display = 'block'; 
        document.getElementById('btn-quests-ui').style.display = 'block';
      }
    }

    document.getElementById('ui-hair-style').addEventListener('change', (e) => { avatarData.hairStyle = e.target.value; if(playerCharacter) playerCharacter.updateVisuals(); });
    document.getElementById('ui-hair-color').addEventListener('input', (e) => { avatarData.hairColor = e.target.value; if(playerCharacter) playerCharacter.updateVisuals(); });
    document.getElementById('ui-clothes-color').addEventListener('input', (e) => { avatarData.clothesColor = e.target.value; if(playerCharacter) playerCharacter.updateVisuals(); });
    
    document.getElementById('btn-start').addEventListener('click', () => {
      initAudio(); 
      gameMode = 'FARMING'; 
      ccModal.style.display = 'none'; 
      document.getElementById('toolbar-container').style.display = 'flex';
      hudTop.style.display = 'flex'; 
      document.getElementById('neighbor-bar-wrapper').style.display = 'flex'; 
      document.getElementById('btn-edit-mode').style.display = 'block';
      
      if (!playerCharacter) playerCharacter = new PlayerCharacter();
      
      loadHouseModel(houseTier); 
