          const cow = animals.find(a => a.type === 'ANIM_Cow' && a.readyToMilk);
          
          if (readyCrop) { 
              this.targetObj = readyCrop; 
              this.targetType = 'CROP'; 
              this.state = 'MOVING'; 
          } 
          else if (drop) { 
              this.targetObj = drop; 
              this.targetType = 'DROP'; 
              this.state = 'MOVING'; 
          } 
          else if (cow) { 
              this.targetObj = cow; 
