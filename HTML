      else if (type === 'DECOR_SCARECROW') mesh = createScarecrow(); 
      else if (type === 'DECOR_WHEELBARROW') mesh = createWheelbarrow(); 
      else if (type === 'DECOR_CAR') mesh = createCar(); 
      else if (type === 'DECOR_BOBET') mesh = createBobet(); 
      else if (type === 'DECOR_XMAS_TREE') mesh = createXmasTree(false); 
      else if (type === 'DECOR_WHITE_XMAS_TREE') mesh = createXmasTree(true); 
