          if (this.targetType === 'HOUSE') {
              targetPos = new THREE.Vector3(3 - GRID_SIZE/2 + 0.5, 0, 3 - GRID_SIZE/2 + 0.5);
          }
          else if (this.targetType === 'CROP') { 
              if(!crops.includes(this.targetObj) || this.targetObj.isDead) { 
                  this.state = 'IDLE'; 
                  return; 
              } 
              targetPos = this.targetObj.group.position; 
          } 
          else if (this.targetType === 'DROP') { 
              if(!drops.includes(this.targetObj)) { 
                  this.state = 'IDLE'; 
                  return; 
              } 
              targetPos = this.targetObj.mesh.position; 
          } 
          else if (this.targetType === 'COW') { 
              if(!animals.includes(this.targetObj) || !this.targetObj.readyToMilk) { 
                  this.state = 'IDLE'; 
                  return; 
              } 
              targetPos = this.targetObj.mesh.position; 
          } 
          else { 
              this.state = 'IDLE'; 
              return; 
          }
          
          const dir = new THREE.Vector3(targetPos.x, 0, targetPos.z).sub(new THREE.Vector3(this.group.position.x, 0, this.group.position.z));
          const dist = dir.length();
          
          if (this.targetType === 'HOUSE' && dist < 1.5) { 
              this.state = 'RESTING'; 
              this.group.rotation.y = Math.PI; 
              return; 
          }

          if (this.targetType !== 'HOUSE' && dist < 0.5) { 
              this.state = 'HARVESTING'; 
              this.harvestTimer = (this.targetType === 'COW') ? 2.0 : 1.0; 
          } else { 
              const targetAngle = Math.atan2(dir.x, dir.z); 
              const rotDiff = targetAngle - this.group.rotation.y; 
              this.group.rotation.y += Math.atan2(Math.sin(rotDiff), Math.cos(rotDiff)) * 10 * delta; 
              dir.normalize(); 
              this.group.position.add(dir.multiplyScalar(this.speed * delta)); 
              this.group.position.y = Math.abs(Math.sin(time * 15)) * 0.1; 
          }
        } else if (this.state === 'HARVESTING') {
          this.harvestTimer -= delta;
          if (this.harvestTimer <= 0) {
            if (statsData.energy < 1) { 
                showNotification("Out of Energy!", "#ff4433"); 
                this.state = 'IDLE'; 
                this.targetObj = null; 
                return; 
            }
            statsData.energy -= 1;
            
            if (this.targetType === 'CROP' && this.targetObj && crops.includes(this.targetObj)) {
              const conf = ITEM_CONFIG[this.targetObj.type] || { reward: 15 };
              let posX = this.targetObj.group.position.x; 
              let posZ = this.targetObj.group.position.z;
              
              let cropName = this.targetObj.type.replace('CROP_', '').toLowerCase();
              processQuestProgress('harvest_' + cropName, 1);
              
              if(!statsData.inventory) statsData.inventory = {};
              let cropInvName = this.targetObj.type.replace('CROP_', '');
              statsData.inventory[cropInvName] = (statsData.inventory[cropInvName] || 0) + 1; // Add to inventory
              
              this.targetObj.destroy(); 
              crops.splice(crops.indexOf(this.targetObj), 1); 
              farmGrid[this.targetObj.col][this.targetObj.row] = 0;
              statsData.coins += conf.reward; 
              addXP(10); 
              showFloatingText(`+${conf.reward} 🪙`, '#ffe680', posX, posZ); 
              spawnDust(posX, posZ); 
              playSound('pop');
              
            } else if (this.targetType === 'DROP' && this.targetObj && drops.includes(this.targetObj)) {
              let reward = this.targetObj.type === 'EGG' ? 15 : 50;
              let posX = this.targetObj.mesh.position.x; 
              let posZ = this.targetObj.mesh.position.z;
              
              if(this.targetObj.type === 'EGG') processQuestProgress('collect_egg', 1);
              if(this.targetObj.type === 'TRUFFLE') processQuestProgress('collect_truffle', 1);
              
              scene.remove(this.targetObj.mesh); 
              drops.splice(drops.indexOf(this.targetObj), 1);
              statsData.coins += reward; 
              addXP(10); 
              showFloatingText(`+${reward} 🪙`, '#ffe680', posX, posZ); 
              spawnDust(posX, posZ); 
              playSound('pop');
              
            } else if (this.targetType === 'COW' && this.targetObj && animals.includes(this.targetObj)) {
              this.targetObj.lastProductTime = time; 
              this.targetObj.readyToMilk = false;
              processQuestProgress('collect_milk', 1);
              
              statsData.coins += 80; 
              addXP(10); 
              showFloatingText(`+80 🪙`, '#ffe680', this.targetObj.mesh.position.x, this.targetObj.mesh.position.z); 
              playSound('pop');
            }
            
            updateHUD(); 
            syncDirty = true; 
            this.state = 'IDLE'; 
            this.targetObj = null;
          }
        }
      }
    }

