            buildFarm(localStateBackup, false); 
            localStateBackup = null; 
            updateSyncUI('Returned Home', '#77bb44'); 
        } 
    });

    function loadNeighbors() {
      if (typeof google !== 'undefined' && google.script) {
        google.script.run.withSuccessHandler((neighborList) => {
            const nbw = document.getElementById('neighbor-bar-wrapper');
            nbw.innerHTML = ''; 
            if (neighborList.length === 0) { 
                nbw.innerHTML = '<div style="color:white; font-weight:bold; padding: 20px;">No other farmers found.</div>'; 
                return; 
            }
            neighborList.forEach(friendId => {
              const card = document.createElement('div'); 
              card.className = 'neighbor-card';
              let displayStr = friendId.split('@')[0]; 
              const firstLetter = displayStr.charAt(0).toUpperCase();
              card.innerHTML = `<div class="neighbor-avatar">${firstLetter}</div><div class="neighbor-name">${displayStr}</div>`;
              card.addEventListener('click', () => visitNeighbor(friendId)); 
              nbw.appendChild(card);
            });
        }).getNeighborList(USER_ID);
      }
    }

    setInterval(() => {
      if (syncDirty && typeof google !== 'undefined' && google.script && !isVisiting && gameMode === 'FARMING') {
        updateSyncUI('Saving to cloud...', '#0099ff');
        const cropsMap = crops.map(c => ({col: c.col, row: c.row, type: c.type, scale: c.scale, readyTime: c.readyTime, isDead: c.isDead}));
        const bldgMap = buildings.map(b => ({col: b.col, row: b.row, type: b.type}));
        const decorMap = decorations.map(d => ({col: d.col, row: d.row, type: d.type}));
        const animMap = animals.map(a => ({col: a.col, row: a.row, type: a.type})).concat(pendingAnimals);
        const fullState = { farmName, houseTier, grid: farmGrid, avatar: avatarData, stats: statsData, crops: cropsMap, buildings: bldgMap, decorations: decorMap, animals: animMap };
        google.script.run.withSuccessHandler(() => { syncDirty = false; updateSyncUI('All changes saved', '#77bb44'); }).saveFarmState(USER_ID, JSON.stringify(fullState));
      }
    }, SYNC_INTERVAL_MS);

    if (typeof google !== 'undefined' && google.script) {
      updateSyncUI('Fetching user...', '#fff');
      google.script.run.withSuccessHandler((playerData) => {
          USER_ID = playerData.email; 
          updateHUD();
          google.script.run.withSuccessHandler((savedJSON) => {
              if (savedJSON) { 
                  buildFarm(JSON.parse(savedJSON), false); 
                  gameMode = 'FARMING'; 
                  hudTop.style.display = 'flex'; 
                  document.getElementById('btn-edit-mode').style.display = 'block'; 
                  updateSyncUI('Loaded from Cloud', '#77bb44'); 
