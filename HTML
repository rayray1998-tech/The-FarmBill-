              loadNeighbors();
          }).getFarmState(USER_ID);
      }).getInitialPlayerData();
    } else { 
        gameMode = 'CREATING'; 
        ccModal.style.display = 'flex'; 
        if(playerCharacter) playerCharacter.updateVisuals(); 
    }

    const clock = new THREE.Clock(); 
    const dayColor = new THREE.Color(0x92d0ff); 
    const nightColor = new THREE.Color(0x000b1a);
    
    function animate() {
      requestAnimationFrame(animate);
      const delta = clock.getDelta(); 
      const t = clock.getElapsedTime(); 
      customUniforms.uTime.value = t;
      
      for (let i = dustParticles.length - 1; i >= 0; i--) {
        const p = dustParticles[i]; 
        p.life--;
        if (p.life <= 0) { 
            scene.remove(p.mesh); 
            dustParticles.splice(i, 1); 
        } else { 
            p.mesh.position.x += p.vx; 
            p.mesh.position.y += p.vy; 
            p.mesh.position.z += p.vz; 
            const s = p.life / 30; 
            p.mesh.scale.set(s, s, s); 
        }
      }
      
      let isBlink = (Date.now() % 1000) > 500;
      xmasLights.forEach(l => { 
          l.mat.color.setHex(isBlink ? l.baseCol : 0x000000); 
      });
      
      animatedPonds.forEach(p => {
          let cycle = (t + p.offset) % 4; 
          if (cycle < 1) { 
              p.fish.position.y = Math.sin(cycle * Math.PI) * 1.5; 
              p.fish.position.x = Math.cos(cycle * Math.PI * 2) * 0.8; 
              p.fish.position.z = Math.sin(cycle * Math.PI * 2) * 0.8; 
              p.fish.rotation.x = cycle * Math.PI * 2; 
          } else {
              p.fish.position.y = -1; 
          }
      });

      const cycle = (Date.now() % 120000) / 120000; 
      const timeOfDay = Math.cos(cycle * Math.PI * 2); 
      isNight = timeOfDay < -0.2;
      const lerpFactor = (timeOfDay + 1) / 2; 
      scene.background.lerpColors(nightColor, dayColor, lerpFactor); 
      dirLight.intensity = Math.max(0.1, lerpFactor * 1.2);

      if (Math.random() < 0.0005) isRaining = !isRaining;
      rainSystem.visible = isRaining;
      if (isRaining) {
          const positions = rainSystem.geometry.attributes.position.array;
          for(let i=0; i<rainCount; i++) { 
              positions[i*3+1] -= 15 * delta; 
              if (positions[i*3+1] < 0) positions[i*3+1] = 30; 
          }
          rainSystem.geometry.attributes.position.needsUpdate = true;
      }
      
      if (playerCharacter && !isVisiting && gameMode === 'FARMING' && document.getElementById('leaderboard-modal').style.display !== 'flex' && document.getElementById('quests-modal').style.display !== 'flex') {
          playerCharacter.update(delta, t);
      }
      
      crops.forEach(c => {
        if (c.isDead) return;
        if (c.scale < 1.0) { 
            c.scale += isRaining ? 0.001 : 0.0005; 
            if (c.scale >= 1.0) { 
                c.scale = 1.0; 
                c.readyTime = t; 
            } 
            c.plantMesh.scale.set(c.scale, c.scale, c.scale); 
        } else if (t - c.readyTime > 120) { 
            c.isDead = true; 
            c.plantMesh.traverse(child => { 
                if (child.isMesh && child.material !== outlineMat) child.material = deadMat; 
            }); 
        }
      });

      if (document.getElementById('leaderboard-modal').style.display !== 'flex' && document.getElementById('quests-modal').style.display !== 'flex') {
        let dHouse = decorations.find(d => d.type === 'DECOR_DOG_HOUSE');
        animals.forEach(a => {
          if (a.lastProductTime === undefined) a.lastProductTime = t;
          if (a.type === 'ANIM_Chick' && t - a.lastProductTime > 30) { 
              a.lastProductTime = t; 
              const egg = new THREE.Mesh(new THREE.SphereGeometry(0.1, 8, 8), new THREE.MeshToonMaterial({color:0xffffff, gradientMap: gradientTexture})); 
              egg.position.copy(a.mesh.position); 
              addOutline(egg); 
              scene.add(egg); 
              drops.push({ mesh: egg, type: 'EGG', x: egg.position.x, z: egg.position.z }); 
          }
          if (a.type === 'ANIM_Hog' && t - a.lastProductTime > 45) { 
              a.lastProductTime = t; 
              const truffle = new THREE.Mesh(new THREE.SphereGeometry(0.12, 6, 6), dirtMat); 
              truffle.position.copy(a.mesh.position); 
              addOutline(truffle); 
              scene.add(truffle); 
              drops.push({ mesh: truffle, type: 'TRUFFLE', x: truffle.position.x, z: truffle.position.z }); 
          }
          if (a.type === 'ANIM_Cow') a.readyToMilk = (t - a.lastProductTime > 60);

          if (isNight) {
            let nearestBarn = null; 
            let minDist = Infinity;
            buildings.forEach(b => { 
                if (b.type === 'BUILD_BARN') { 
                    const d = new THREE.Vector2(b.col - a.col, b.row - a.row).length(); 
                    if (d < minDist) { minDist = d; nearestBarn = b; } 
                } 
            });
            if (nearestBarn) { 
                a.targetX = nearestBarn.col - GRID_SIZE/2 + 1.0; 
                a.targetZ = nearestBarn.row - GRID_SIZE/2 + 1.0; 
            } else { 
                a.targetX = 0; 
                a.targetZ = 0; 
            }
          } else {
             const dirDist = new THREE.Vector3(a.targetX - a.mesh.position.x, 0, a.targetZ - a.mesh.position.z).length();
             if (dirDist < 0.1) {
               if (a.type === 'ANIM_Dog' && dHouse) { 
                   a.targetX = dHouse.col - GRID_SIZE/2 + 0.5 + (Math.random()-0.5)*3; 
                   a.targetZ = dHouse.row - GRID_SIZE/2 + 0.5 + (Math.random()-0.5)*3; 
               } else { 
                   a.targetX = (Math.random() - 0.5) * (GRID_SIZE - 2); 
                   a.targetZ = (Math.random() - 0.5) * (GRID_SIZE - 2); 
               }
               a.col = Math.max(0, Math.min(GRID_SIZE-1, Math.floor(a.mesh.position.x) + (GRID_SIZE / 2))); 
               a.row = Math.max(0, Math.min(GRID_SIZE-1, Math.floor(a.mesh.position.z) + (GRID_SIZE / 2)));
             }
          }
          
          const dir = new THREE.Vector3().subVectors(new THREE.Vector3(a.targetX, 0, a.targetZ), a.mesh.position); 
          dir.y = 0;
          
          if (dir.length() > 0.1) {
            a.state = 'moving'; 
            a.mesh.rotation.x = 0; 
            a.mesh.rotation.z = 0; 
            const moveStep = dir.normalize().multiplyScalar(a.speed * delta); 
            a.mesh.position.add(moveStep);
            const targetAngle = Math.atan2(dir.x, dir.z); 
            const rotDiff = targetAngle - a.mesh.rotation.y; 
            a.mesh.rotation.y += Math.atan2(Math.sin(rotDiff), Math.cos(rotDiff)) * 5 * delta;
            a.mesh.position.y = a.baseY + Math.abs(Math.sin(t * 10 * a.speed)) * 0.1;
          } else {
            a.state = 'idle';
            if (a.type === 'ANIM_Chick') a.mesh.rotation.x = Math.sin(t * 15) * 0.3 - 0.2; 
            else if (a.type === 'ANIM_Cow') a.mesh.rotation.x = THREE.MathUtils.lerp(a.mesh.rotation.x, -0.4, 0.05); 
            else if (a.type === 'ANIM_Hog') a.mesh.rotation.z = Math.sin(t * 5) * 0.4; 
          }
        });
      }
      controls.update(); 
      renderer.render(scene, camera);
    }
    
    animate();

    window.addEventListener('resize', () => {
      const aspect = window.innerWidth / window.innerHeight; 
      camera.left = -frustumSize * aspect / 2; 
      camera.right = frustumSize * aspect / 2; 
      camera.top = frustumSize / 2; 
      camera.bottom = -frustumSize / 2; 
      camera.updateProjectionMatrix(); 
      renderer.setSize(window.innerWidth, window.innerHeight);
    }, false);
  </script>
</body>
</html>
