    class Crop {
      constructor(data) {
        this.data = data; 
        this.col = data.col; 
        this.row = data.row; 
        this.type = data.type; 
        this.scale = data.scale || 0.1; 
        this.readyTime = data.readyTime || (this.scale >= 1.0 ? clock.getElapsedTime() : null); 
        this.isDead = data.isDead || false;
        
        this.group = new THREE.Group(); 
        this.group.position.set(data.col - GRID_SIZE/2 + 0.5, 0.05, data.row - GRID_SIZE/2 + 0.5);
        this.plot = new THREE.Mesh(cropPlotGeo, dirtMat); 
        addOutline(this.plot); 
        this.group.add(this.plot);
        
        if (this.type === 'CROP_WHEAT') this.plantMesh = createWheat(); 
        else if (this.type === 'CROP_TOMATO') this.plantMesh = createTomato(); 
        else if (this.type === 'CROP_KAMOTE') this.plantMesh = createKamote(); 
        else if (this.type === 'CROP_KANGKONG') this.plantMesh = createKangkong(); 
        else if (this.type === 'CROP_BANANA') this.plantMesh = createBananaTree(); 
        else if (this.type === 'CROP_APPLE') this.plantMesh = createAppleTree(); 
        else this.plantMesh = createWheat(); 
        
        this.plantMesh.scale.setScalar(this.scale); 
        this.group.add(this.plantMesh);
        
        if (this.isDead) { 
            this.plantMesh.traverse(child => { 
                if (child.isMesh && child.material !== outlineMat) child.material = deadMat; 
            }); 
        }
        scene.add(this.group);
      }
      destroy() { 
          scene.remove(this.group); 
      }
    }

