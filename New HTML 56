    class Crop {
      constructor(data) {
        this.data = data; this.col = data.col; this.row = data.row; this.type = data.type; 
        this.plantedAt = data.plantedAt || Date.now(); this.isDead = data.isDead || false;
        this.targetedBy = null; // Worker ID lock
        
        this.group = new THREE.Group(); this.group.position.set(data.col - Math.floor(GRID_SIZE/2) + 0.5, 0.05, data.row - Math.floor(GRID_SIZE/2) + 0.5);
        this.plot = new THREE.Mesh(cropPlotGeo, dirtMat); addOutline(this.plot); this.group.add(this.plot);
        
        if (this.type === 'CROP_WHEAT') this.plantMesh = createWheat(); else if (this.type === 'CROP_TOMATO') this.plantMesh = createTomato(); 
        else if (this.type === 'CROP_KAMOTE') this.plantMesh = createKamote(); else if (this.type === 'CROP_KANGKONG') this.plantMesh = createKangkong(); 
        else if (this.type === 'CROP_BANANA') this.plantMesh = createBananaTree(); else if (this.type === 'CROP_APPLE') this.plantMesh = createAppleTree(); 
        else this.plantMesh = createWheat(); 

        const duration = CROP_GROWTH_TIMES[this.type] || 1800000; const elapsed = Date.now() - this.plantedAt;
        this.scale = Math.min(1.0, 0.1 + 0.9 * (elapsed / duration));
        
        this.plantMesh.scale.setScalar(this.scale); this.group.add(this.plantMesh);
        if (this.isDead) { this.plantMesh.traverse(child => { if (child.isMesh && child.material !== outlineMat) child.material = deadMat; }); }
        scene.add(this.group);
      }
      destroy() { scene.remove(this.group); }
    }

