    window.addEventListener('pointerdown', (e) => {
      if (e.target.closest('#hud-top') || e.target.closest('#toolbar-container') || e.target.closest('.modal-bg') || fishingActive) return;
      if (e.target.closest('#edit-popup') || e.target.closest('#btn-edit-mode')) return;
      if (isVisiting || gameMode !== 'FARMING') return;
      
      raycaster.setFromCamera(mouse, camera);
      
      if (isEditMode) {
          document.getElementById('edit-popup').style.display = 'none';
          if (movingBuilding) {
              const intersects = raycaster.intersectObjects([farmBase]);
              if (intersects.length > 0) {
                 let size = getItemSize(movingBuilding.type); let col = Math.floor(intersects[0].point.x - (size.w-1)*0.5) + Math.floor(GRID_SIZE / 2); let row = Math.floor(intersects[0].point.z - (size.h-1)*0.5) + Math.floor(GRID_SIZE / 2);
                 if (canPlaceItem(col, row, size.w, size.h)) {
                     if (statsData.coins >= 50) {
                         statsData.coins -= 50; occupyGrid(col, row, size.w, size.h, movingBuilding.isDecor ? 30 : 10); movingBuilding.col = col; movingBuilding.row = row;
                         movingBuilding.group.position.set(col - Math.floor(GRID_SIZE/2) + size.w/2, movingBuilding.group.position.y, row - Math.floor(GRID_SIZE/2) + size.h/2);
                         movingBuilding = null; updateHUD(); syncDirty = true; spawnDust(col - Math.floor(GRID_SIZE/2) + size.w/2, row - Math.floor(GRID_SIZE/2) + size.h/2); playSound('coin');
                     } else { showNotification("Not enough coins!", "#ff4433"); occupyGrid(movingBuilding.col, movingBuilding.row, size.w, size.h, movingBuilding.isDecor ? 30 : 10); movingBuilding = null; }
                 }
              }
          } else if (hoveredBuilding) { 
              document.getElementById('edit-popup').style.left = e.clientX + 'px'; document.getElementById('edit-popup').style.top = e.clientY + 'px'; document.getElementById('edit-popup').style.display = 'flex'; 
          }
          return;
      }
      
      if (!highlightMesh.visible) {
          const intersectsDecor = raycaster.intersectObjects(interactableObjects, true);
          for(let i=0; i<intersectsDecor.length; i++) {
              let p = intersectsDecor[i].object.parent;
              while(p && p !== scene) {
                  if(p.userData && p.userData.ref && p.userData.ref.type === 'DECOR_FISH_POND') {
                      let dist = new THREE.Vector2(activeWorkers[0].group.position.x - p.position.x, activeWorkers[0].group.position.z - p.position.z).length();
                      if(dist < 3.0) startFishing(); else showNotification("Get closer to fish!", "#ffcc00"); return;
                  }
                  p = p.parent;
              }
          }
          return;
      }
      
      const intersects = raycaster.intersectObjects([farmBase]);
      
      if (intersects.length > 0) {
        let size = getItemSize(currentTool); let col = Math.floor(intersects[0].point.x - (size.w-1)*0.5) + Math.floor(GRID_SIZE / 2); let row = Math.floor(intersects[0].point.z - (size.h-1)*0.5) + Math.floor(GRID_SIZE / 2);
        if (col < 0 || col + size.w > GRID_SIZE || row < 0 || row + size.h > GRID_SIZE) return;

        const existingCrop = crops.find(c => c.col === col && c.row === row);
        if (existingCrop && existingCrop.isDead) {
          if (statsData.energy >= 1) { 
              statsData.energy -= 1; existingCrop.destroy(); crops.splice(crops.indexOf(existingCrop), 1); farmGrid[col][row] = 0; 
              updateHUD(); syncDirty = true; spawnDust(col - Math.floor(GRID_SIZE/2) + 0.5, row - Math.floor(GRID_SIZE/2) + 0.5); showFloatingText("Cleared!", "#fff", col - Math.floor(GRID_SIZE/2) + 0.5, row - Math.floor(GRID_SIZE/2) + 0.5); 
          } else { showNotification("Out of Energy!", "#ff4433"); }
          return;
        }

        let conf = ITEM_CONFIG[currentTool] || {cost:150, reqLevel:1};
        
        if (currentTool.startsWith('CROP')) {
          if (canPlaceItem(col, row, 1, 1)) {
            if (statsData.coins >= conf.cost) {
              if (statsData.energy < 1) { showNotification("Out of Energy!", "#ff4433"); return; }
              statsData.coins -= conf.cost; statsData.energy -= 1; farmGrid[col][row] = 1; crops.push(new Crop({ col, row, type: currentTool, plantedAt: Date.now() })); 
              processQuestProgress('plant_crop', 1); updateHUD(); syncDirty = true; spawnDust(col - Math.floor(GRID_SIZE/2) + 0.5, row - Math.floor(GRID_SIZE/2) + 0.5);
            } else { showNotification("Not Enough Coins!", "#ff4433"); }
          }
        } else if (currentTool.startsWith('BUILD')) {
          if (canPlaceItem(col, row, size.w, size.h)) {
            if (statsData.coins >= conf.cost) {
              if (statsData.energy < 1) { showNotification("Out of Energy!", "#ff4433"); return; }
              statsData.coins -= conf.cost; statsData.energy -= 1; placeBuilding(col, row, currentTool); 
              updateHUD(); syncDirty = true; highlightMesh.material.color.setHex(0xff0000); spawnDust(col - Math.floor(GRID_SIZE/2) + size.w/2, row - Math.floor(GRID_SIZE/2) + size.h/2);
            } else { showNotification("Not Enough Coins!", "#ff4433"); }
          }
        } else if (currentTool.startsWith('ANIM')) {
           if (canPlaceItem(col, row, 1, 1)) {
             if (statsData.coins >= conf.cost) {
                if (statsData.energy < 1) { showNotification("Out of Energy!", "#ff4433"); return; }
                statsData.coins -= conf.cost; statsData.energy -= 1; placeAnimal(col, row, currentTool); updateHUD(); syncDirty = true; spawnDust(col - Math.floor(GRID_SIZE/2) + 0.5, row - Math.floor(GRID_SIZE/2) + 0.5);
             } else { showNotification("Not Enough Coins!", "#ff4433"); }
           }
        } else if (currentTool.startsWith('DECOR')) {
           if (canPlaceItem(col, row, size.w, size.h)) {
             if (statsData.coins >= conf.cost) {
                statsData.coins -= conf.cost; placeDecor(col, row, currentTool); updateHUD(); syncDirty = true; spawnDust(col - Math.floor(GRID_SIZE/2) + size.w/2, row - Math.floor(GRID_SIZE/2) + size.h/2);
             } else { showNotification("Not Enough Coins!", "#ff4433"); }
           }
        }
        if (syncDirty) updateSyncUI('Unsaved Changes...', '#ffcc00');
      }
    });

    function clearScene() {
      crops.forEach(c => c.destroy()); crops.length = 0;
      buildings.forEach(b => { scene.remove(b.group); let idx = interactableObjects.indexOf(b.group); if(idx>-1) interactableObjects.splice(idx,1); }); buildings.length = 0;
      decorations.forEach(d => { scene.remove(d.group); let idx = interactableObjects.indexOf(d.group); if(idx>-1) interactableObjects.splice(idx,1); }); decorations.length = 0;
      animals.forEach(a => scene.remove(a.mesh)); animals.length = 0;
      drops.forEach(d => scene.remove(d.mesh)); drops.length = 0;
      activeWorkers.forEach(w => scene.remove(w.group)); activeWorkers.length = 0;
      pendingAnimals.length = 0; xmasLights.length = 0; animatedPonds.length = 0;
      
      farmGrid = Array.from({ length: GRID_SIZE }, () => Array(GRID_SIZE).fill(0));
      reserveHouseGrid();
    }

    function buildFarm(parsedData, readOnly) {
      clearScene();
      avatarData = Object.assign({ hairStyle: 'short', hairColor: '#4a3018', clothesColor: '#2266cc', activeChar: 'default', unlocked: ['default'] }, parsedData.avatar);
      statsData = Object.assign({ coins: 500, level: 1, xp: 0, energy: 50, quests: [], inventory: {}, gridSize: 24, workers: [] }, parsedData.stats);
      farmName = parsedData.farmName || (readOnly ? "Neighbor's Farm" : "My Farm");
      houseTier = parsedData.houseTier || 1;
      
      if (statsData.gridSize === 36) expandLandTo36();

      document.getElementById('farm-name-overlay').innerText = farmName; 
      document.getElementById('ui-farm-name-input').value = readOnly ? "" : farmName;
      
      buildProceduralHouse(houseTier);
      
      if (!statsData.workers || statsData.workers.length === 0) statsData.workers = [avatarData.activeChar];
      statsData.workers.forEach((wType, idx) => {
          activeWorkers.push(new PlayerCharacter(idx, wType));
      });
      
      if (parsedData.crops) parsedData.crops.forEach(d => { farmGrid[d.col][d.row] = 1; crops.push(new Crop(d)); });
      if (parsedData.buildings) parsedData.buildings.forEach(d => placeBuilding(d.col, d.row, d.type));
      if (parsedData.decorations) parsedData.decorations.forEach(d => placeDecor(d.col, d.row, d.type));
      if (parsedData.animals) parsedData.animals.forEach(d => placeAnimal(d.col, d.row, d.type));
      
      isVisiting = readOnly; updateHUD();
      
      if (isVisiting) {
        document.getElementById('toolbar-container').style.display = 'none'; document.getElementById('neighbor-bar-wrapper').style.display = 'none'; 
        document.getElementById('return-btn').style.display = 'block'; document.getElementById('read-only-badge').style.display = 'block'; 
        highlightMesh.visible = false; activeWorkers.forEach(w => w.group.visible = false);
        document.getElementById('farm-name-ui').style.display = 'none'; document.getElementById('btn-leaderboard').style.display = 'none'; 
        document.getElementById('btn-upgrade-shop').style.display = 'none'; document.getElementById('btn-market-ui').style.display = 'none';
        document.getElementById('btn-edit-mode').style.display = 'none'; document.getElementById('btn-quests-ui').style.display = 'none';
      } else {
        document.getElementById('toolbar-container').style.display = 'flex'; document.getElementById('neighbor-bar-wrapper').style.display = 'flex'; 
        document.getElementById('return-btn').style.display = 'none'; document.getElementById('read-only-badge').style.display = 'none'; 
        activeWorkers.forEach(w => w.group.visible = true);
        document.getElementById('farm-name-ui').style.display = 'flex'; document.getElementById('btn-leaderboard').style.display = 'block'; 
        document.getElementById('btn-upgrade-shop').style.display = 'block'; document.getElementById('btn-market-ui').style.display = 'block';
        document.getElementById('btn-edit-mode').style.display = 'block'; document.getElementById('btn-quests-ui').style.display = 'block';
      }
    }

    document.getElementById('ui-hair-style').addEventListener('change', (e) => { avatarData.hairStyle = e.target.value; if(activeWorkers.length>0) activeWorkers[0].updateVisuals(); });
    document.getElementById('ui-hair-color').addEventListener('input', (e) => { avatarData.hairColor = e.target.value; if(activeWorkers.length>0) activeWorkers[0].updateVisuals(); });
    document.getElementById('ui-clothes-color').addEventListener('input', (e) => { avatarData.clothesColor = e.target.value; if(activeWorkers.length>0) activeWorkers[0].updateVisuals(); });
    
    document.getElementById('btn-start').addEventListener('click', () => {
      initAudio(); gameMode = 'FARMING'; ccModal.style.display = 'none'; document.getElementById('toolbar-container').style.display = 'flex';
      hudTop.style.display = 'flex'; document.getElementById('neighbor-bar-wrapper').style.display = 'flex'; document.getElementById('btn-edit-mode').style.display = 'block';
      if (activeWorkers.length === 0) {
          statsData.workers = [avatarData.activeChar];
          activeWorkers.push(new PlayerCharacter(0, avatarData.activeChar));
      }
      buildProceduralHouse(houseTier); syncDirty = true; updateSyncUI('Saving Player...', '#ffcc00'); updateHUD(); playSound('coin');
    });

    document.getElementById('btn-login-submit').addEventListener('click', () => {
        const emailInput = document.getElementById('login-email-input').value.trim();
        if(!emailInput) { loginErrorMsg.innerText = "Please enter an email address."; loginErrorMsg.style.display = 'block'; return; }
        loginErrorMsg.style.display = 'none'; updateSyncUI('Verifying authorization...', '#0099ff');

        if (typeof google !== 'undefined' && google.script) {
            google.script.run.withSuccessHandler((res) => {
                if (res.allowed) {
                    USER_ID = res.email; loginModal.style.display = 'none'; updateSyncUI('Fetching Farm...', '#0099ff');
                    google.script.run.withSuccessHandler((savedJSON) => {
                        if (savedJSON) { 
                            buildFarm(JSON.parse(savedJSON), false); gameMode = 'FARMING'; hudTop.style.display = 'flex'; document.getElementById('btn-edit-mode').style.display = 'block'; updateSyncUI('Loaded from Cloud', '#77bb44'); 
                        } else { 
                            gameMode = 'CREATING'; ccModal.style.display = 'flex'; if(activeWorkers.length>0) activeWorkers[0].updateVisuals(); updateSyncUI('New Player Registered', '#fff'); 
                        }
                        loadNeighbors();
                    }).getFarmState(USER_ID);
                } else {
                    loginErrorMsg.innerText = res.message || "Email not authorized in Masterlist"; loginErrorMsg.style.display = 'block'; updateSyncUI('Access Denied', '#ff4433');
                }
            }).verifyMasterlistEmail(emailInput);
        } else {
            USER_ID = emailInput; loginModal.style.display = 'none'; gameMode = 'CREATING'; ccModal.style.display = 'flex';
            if(activeWorkers.length>0) activeWorkers[0].updateVisuals(); updateSyncUI('Standalone Mode', '#fff');
        }
    });

    function visitNeighbor(friendId) {
      if (isVisiting) return; updateSyncUI(`Traveling to ${friendId}...`, '#0099ff');
      const cropsMap = crops.map(c => ({col: c.col, row: c.row, type: c.type, plantedAt: c.plantedAt, isDead: c.isDead}));
      const bldgMap = buildings.map(b => ({col: b.col, row: b.row, type: b.type}));
      const decorMap = decorations.map(d => ({col: d.col, row: d.row, type: d.type}));
      const animMap = animals.map(a => ({col: a.col, row: a.row, type: a.type})).concat(pendingAnimals);
      localStateBackup = { farmName, houseTier, grid: farmGrid, avatar: avatarData, stats: statsData, crops: cropsMap, buildings: bldgMap, decorations: decorMap, animals: animMap };
      
      if (typeof google !== 'undefined' && google.script) {
        google.script.run.withSuccessHandler((savedJSON) => {
            if (savedJSON) { buildFarm(JSON.parse(savedJSON), true); updateSyncUI(`Viewing ${friendId}'s Farm`, '#aaa'); } 
            else { updateSyncUI('Farm not found.', '#ff0000'); }
        }).getFriendFarmState(friendId);
      }
    }

    document.getElementById('return-btn').addEventListener('click', () => { 
        if (localStateBackup) { buildFarm(localStateBackup, false); localStateBackup = null; updateSyncUI('Returned Home', '#77bb44'); } 
    });

    function loadNeighbors() {
      if (typeof google !== 'undefined' && google.script) {
        google.script.run.withSuccessHandler((neighborList) => {
            const nbw = document.getElementById('neighbor-bar-wrapper'); nbw.innerHTML = ''; 
            if (!neighborList || neighborList.length === 0) { nbw.innerHTML = '<div style="color:white; font-weight:bold; padding: 10px;">No other farmers found.</div>'; return; }
            neighborList.forEach(friendId => {
              const card = document.createElement('div'); card.className = 'neighbor-card';
              let displayStr = friendId.split('@')[0]; const firstLetter = displayStr.charAt(0).toUpperCase();
              card.innerHTML = `<div class="neighbor-avatar">${firstLetter}</div><div class="neighbor-name">${displayStr}</div>`;
              card.addEventListener('click', () => visitNeighbor(friendId)); nbw.appendChild(card);
            });
        }).getNeighborList(USER_ID);
      }
    }

    setInterval(() => {
      if (syncDirty && typeof google !== 'undefined' && google.script && !isVisiting && gameMode === 'FARMING') {
        updateSyncUI('Saving to cloud...', '#0099ff');
        const cropsMap = crops.map(c => ({col: c.col, row: c.row, type: c.type, plantedAt: c.plantedAt, isDead: c.isDead}));
        const bldgMap = buildings.map(b => ({col: b.col, row: b.row, type: b.type}));
        const decorMap = decorations.map(d => ({col: d.col, row: d.row, type: d.type}));
        const animMap = animals.map(a => ({col: a.col, row: a.row, type: a.type})).concat(pendingAnimals);
        const fullState = { farmName, houseTier, grid: farmGrid, avatar: avatarData, stats: statsData, crops: cropsMap, buildings: bldgMap, decorations: decorMap, animals: animMap };
        google.script.run.withSuccessHandler(() => { syncDirty = false; updateSyncUI('All changes saved', '#77bb44'); }).saveFarmState(USER_ID, JSON.stringify(fullState));
      }
    }, SYNC_INTERVAL_MS);

    const clock = new THREE.Clock(); 
    const dayColor = new THREE.Color(0x92d0ff); const nightColor = new THREE.Color(0x000b1a);
    
    function animate() {
      requestAnimationFrame(animate);
      const delta = clock.getDelta(); const t = clock.getElapsedTime(); const now = Date.now(); customUniforms.uTime.value = t;
      
      for (let i = dustParticles.length - 1; i >= 0; i--) {
        const p = dustParticles[i]; p.life--;
        if (p.life <= 0) { scene.remove(p.mesh); dustParticles.splice(i, 1); } 
        else { p.mesh.position.x += p.vx; p.mesh.position.y += p.vy; p.mesh.position.z += p.vz; const s = p.life / 30; p.mesh.scale.set(s, s, s); }
      }

      if (statsData.level >= 15 || houseTier >= 4) {
          if (Math.random() < 0.1) {
              const hX = Math.floor(GRID_SIZE/2) - Math.floor(GRID_SIZE/2) + 0.8; const hY = 2.8; const hZ = Math.floor(GRID_SIZE/2) - Math.floor(GRID_SIZE/2) + 0.2;
              spawnSmoke(hX, hY, hZ);
          }
      }

      for (let i = smokeParticles.length - 1; i >= 0; i--) {
          const sp = smokeParticles[i]; sp.life--;
          if (sp.life <= 0) { scene.remove(sp.mesh); smokeParticles.splice(i, 1); } 
          else { sp.mesh.position.x += sp.vx; sp.mesh.position.y += sp.vy; sp.mesh.position.z += sp.vz; sp.mat.opacity = sp.life / 60; const s = 1 + (1 - sp.life / 60); sp.mesh.scale.set(s, s, s); }
      }
      
      let isBlink = (now % 1000) > 500;
      xmasLights.forEach(l => { l.mat.color.setHex(isBlink ? l.baseCol : 0x000000); });
      
      animatedPonds.forEach(p => {
          let cycle = (t + p.offset) % 4; 
          if (cycle < 1) { p.fish.position.y = Math.sin(cycle * Math.PI) * 1.5; p.fish.position.x = Math.cos(cycle * Math.PI * 2) * 0.8; p.fish.position.z = Math.sin(cycle * Math.PI * 2) * 0.8; p.fish.rotation.x = cycle * Math.PI * 2; } 
          else { p.fish.position.y = -1; }
      });

      const cycle = (now % 120000) / 120000; const timeOfDay = Math.cos(cycle * Math.PI * 2); isNight = timeOfDay < -0.2;
      const lerpFactor = (timeOfDay + 1) / 2; scene.background.lerpColors(nightColor, dayColor, lerpFactor); dirLight.intensity = Math.max(0.1, lerpFactor * 1.2);

      if (Math.random() < 0.0005) isRaining = !isRaining; rainSystem.visible = isRaining;
      if (isRaining) {
          const positions = rainSystem.geometry.attributes.position.array;
          for(let i=0; i<rainCount; i++) { positions[i*3+1] -= 15 * delta; if (positions[i*3+1] < 0) positions[i*3+1] = 30; }
          rainSystem.geometry.attributes.position.needsUpdate = true;
      }
      
      const inModal = document.getElementById('leaderboard-modal').style.display === 'flex' || document.getElementById('quests-modal').style.display === 'flex' || document.getElementById('flea-modal').style.display === 'flex' || document.getElementById('upgrade-modal').style.display === 'flex';
      
      if (!isVisiting && gameMode === 'FARMING' && !inModal) {
          activeWorkers.forEach(w => w.update(delta, t));
      }
      
      crops.forEach(c => {
        if (c.isDead) return;
        const growthDuration = CROP_GROWTH_TIMES[c.type] || 1800000; const elapsed = now - c.plantedAt;
        if (elapsed < growthDuration) { c.scale = 0.1 + 0.9 * (elapsed / growthDuration); c.plantMesh.scale.set(c.scale, c.scale, c.scale); } 
        else if (elapsed < growthDuration * 2) { c.scale = 1.0; c.plantMesh.scale.set(1.0, 1.0, 1.0); } 
        else { c.isDead = true; c.plantMesh.traverse(child => { if (child.isMesh && child.material !== outlineMat) child.material = deadMat; }); }
      });

      if (!inModal) {
        let dHouse = decorations.find(d => d.type === 'DECOR_DOG_HOUSE');
        animals.forEach(a => {
          if (a.lastProductTime === undefined) a.lastProductTime = t;
          
          if (a.type === 'ANIM_Bee' && a.mesh.userData.wings) { a.mesh.userData.wings.forEach(w => w.rotation.z = Math.sin(t * 30) * 0.5); }
          if (a.type === 'ANIM_Fish' && a.mesh.userData.tail) { a.mesh.userData.tail.rotation.y = Math.sin(t * 15) * 0.3; }

          if (a.type === 'ANIM_Chick' && t - a.lastProductTime > 30) { 
              a.lastProductTime = t; const egg = new THREE.Mesh(new THREE.SphereGeometry(0.1, 8, 8), new THREE.MeshToonMaterial({color:0xffffff, gradientMap: gradientTexture})); 
              egg.position.copy(a.mesh.position); addOutline(egg); scene.add(egg); drops.push({ mesh: egg, type: 'EGG', x: egg.position.x, z: egg.position.z, targetedBy: null }); 
          }
          if (a.type === 'ANIM_Hog' && t - a.lastProductTime > 45) { 
              a.lastProductTime = t; const truffle = new THREE.Mesh(new THREE.SphereGeometry(0.12, 6, 6), dirtMat); 
              truffle.position.copy(a.mesh.position); addOutline(truffle); scene.add(truffle); drops.push({ mesh: truffle, type: 'TRUFFLE', x: truffle.position.x, z: truffle.position.z, targetedBy: null }); 
          }
          if (a.type === 'ANIM_Cow') a.readyToMilk = (t - a.lastProductTime > 60);

          if (isNight) {
            let nearestBarn = null; let minDist = Infinity;
            buildings.forEach(b => { 
                if (b.type === 'BUILD_BARN') { const d = new THREE.Vector2(b.col - a.col, b.row - a.row).length(); if (d < minDist) { minDist = d; nearestBarn = b; } } 
            });
            if (nearestBarn) { a.targetX = nearestBarn.col - Math.floor(GRID_SIZE/2) + 1.0; a.targetZ = nearestBarn.row - Math.floor(GRID_SIZE/2) + 1.0; } 
            else { a.targetX = 0; a.targetZ = 0; }
          } else {
             const dirDist = new THREE.Vector3(a.targetX - a.mesh.position.x, 0, a.targetZ - a.mesh.position.z).length();
             if (dirDist < 0.1) {
               if (a.type === 'ANIM_Dog' && dHouse) { 
                   a.targetX = dHouse.col - Math.floor(GRID_SIZE/2) + 0.5 + (Math.random()-0.5)*3; a.targetZ = dHouse.row - Math.floor(GRID_SIZE/2) + 0.5 + (Math.random()-0.5)*3; 
               } else { 
                   a.targetX = (Math.random() - 0.5) * (GRID_SIZE - 2); a.targetZ = (Math.random() - 0.5) * (GRID_SIZE - 2); 
               }
               a.col = Math.max(0, Math.min(GRID_SIZE-1, Math.floor(a.mesh.position.x) + Math.floor(GRID_SIZE / 2))); 
               a.row = Math.max(0, Math.min(GRID_SIZE-1, Math.floor(a.mesh.position.z) + Math.floor(GRID_SIZE / 2)));
             }
          }
          const dir = new THREE.Vector3().subVectors(new THREE.Vector3(a.targetX, 0, a.targetZ), a.mesh.position); dir.y = 0;
          if (dir.length() > 0.1) {
            a.state = 'moving'; a.mesh.rotation.x = 0; a.mesh.rotation.z = 0; 
            const moveStep = dir.normalize().multiplyScalar(a.speed * delta); a.mesh.position.add(moveStep);
            const targetAngle = Math.atan2(dir.x, dir.z); const rotDiff = targetAngle - a.mesh.rotation.y; 
            a.mesh.rotation.y += Math.atan2(Math.sin(rotDiff), Math.cos(rotDiff)) * 5 * delta;
            a.mesh.position.y = a.baseY + Math.abs(Math.sin(t * 10 * a.speed)) * 0.1;
          } else {
            a.state = 'idle';
            if (a.type === 'ANIM_Chick') a.mesh.rotation.x = Math.sin(t * 15) * 0.3 - 0.2; 
            else if (a.type === 'ANIM_Cow') a.mesh.rotation.x = THREE.MathUtils.lerp(a.mesh.rotation.x, -0.4, 0.05); 
            else if (a.type === 'ANIM_Hog') a.mesh.rotation.z = Math.sin(t * 5) * 0.4; 
          }
        });
      }
      controls.update(); renderer.render(scene, camera);
    }
    
    animate();

    window.addEventListener('resize', () => {
      const aspect = window.innerWidth / window.innerHeight; camera.left = -frustumSize * aspect / 2; camera.right = frustumSize * aspect / 2; 
      camera.top = frustumSize / 2; camera.bottom = -frustumSize / 2; camera.updateProjectionMatrix(); renderer.setSize(window.innerWidth, window.innerHeight);
    }, false);
  </script>
</body>
