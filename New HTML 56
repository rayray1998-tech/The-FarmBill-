        const g = new THREE.Group();
        
        const wallColor = tier >= 3 ? createToon(0xffffff) : createToon(0xddccaa);
        const roofColor = tier >= 4 ? createToon(0x222222) : redMat;

        let baseWidth = tier === 1 ? 2.0 : (tier >= 3 ? 2.8 : 2.4);
        let baseHeight = tier >= 3 ? 2.2 : 1.5;
        let baseDepth = tier === 1 ? 2.0 : (tier >= 3 ? 2.8 : 2.4);

        const base = new THREE.Mesh(new THREE.BoxGeometry(baseWidth, baseHeight, baseDepth), wallColor); base.position.y = baseHeight / 2; addOutline(base); g.add(base);

        let roofHeight = 1.5;
        const roof = new THREE.Mesh(new THREE.ConeGeometry(baseWidth * 0.8, roofHeight, 4), roofColor); roof.rotation.y = Math.PI/4; roof.position.y = baseHeight + roofHeight/2; addOutline(roof); g.add(roof);

        const door = new THREE.Mesh(new THREE.BoxGeometry(0.5, 1.0, 0.1), brownMat); door.position.set(0, 0.5, baseDepth/2 + 0.01); g.add(door);
        const win = new THREE.Mesh(new THREE.PlaneGeometry(0.6, 0.6), lightBlueMat); win.position.set(baseWidth/4, 0.8, baseDepth/2 + 0.02); g.add(win);
        
        if (tier >= 3) {
