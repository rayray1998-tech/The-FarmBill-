    function placeAnimal(col, row, type) {
      const startX = col - Math.floor(GRID_SIZE/2) + 0.5; const startZ = row - Math.floor(GRID_SIZE/2) + 0.5;
      const requestedAnimalName = type.replace('ANIM_', ''); const animalInfo = animalData.find(a => a.name === requestedAnimalName) || animalData[0];
      
      const pendingData = { col, row, type }; pendingAnimals.push(pendingData);

      if (animalInfo.procedural) {
          let model;
          if (animalInfo.name === 'Koala') model = createKoala(); else if (animalInfo.name === 'Crab') model = createCrab();
          else if (animalInfo.name === 'Bee') model = createBee(); else if (animalInfo.name === 'Deer') model = createDeer();
          else if (animalInfo.name === 'Lion') model = createLion(); else if (animalInfo.name === 'Fish') model = createFishAnim();
          
          const box = new THREE.Box3().setFromObject(model); const size = new THREE.Vector3(); box.getSize(size);
          const maxDim = Math.max(size.x, size.y, size.z); if (maxDim > 0) { const scaleFactor = 0.8 / maxDim; model.scale.set(scaleFactor, scaleFactor, scaleFactor); }
          const scaledBox = new THREE.Box3().setFromObject(model); const baseY = -scaledBox.min.y;
          model.position.set(startX, baseY, startZ); scene.add(model);
          animals.push({ mesh: model, targetX: startX, targetZ: startZ, type: type, col: col, row: row, baseY: baseY, speed: 1.0 + (Math.random() * 0.5), lastProductTime: undefined, readyToMilk: false, state: 'moving', targetedBy: null });
          const idx = pendingAnimals.indexOf(pendingData); if (idx > -1) pendingAnimals.splice(idx, 1);
      } else {
          gltfLoader.load(animalInfo.url, function(gltf) {
            const model = gltf.scene;
            model.traverse((child) => { if (child.isMesh && child.material) child.material = new THREE.MeshStandardMaterial({ map: animalTexture, roughness: 0.8 }); });
            const box = new THREE.Box3().setFromObject(model); const size = new THREE.Vector3(); box.getSize(size);
            const maxDim = Math.max(size.x, size.y, size.z); if (maxDim > 0) { const scaleFactor = 0.8 / maxDim; model.scale.set(scaleFactor, scaleFactor, scaleFactor); }
            const scaledBox = new THREE.Box3().setFromObject(model); const baseY = -scaledBox.min.y;
            model.position.set(startX, baseY, startZ); scene.add(model);
            animals.push({ mesh: model, targetX: startX, targetZ: startZ, type: type, col: col, row: row, baseY: baseY, speed: 1.0 + (Math.random() * 0.5), lastProductTime: undefined, readyToMilk: false, state: 'moving', targetedBy: null });
            const idx = pendingAnimals.indexOf(pendingData); if (idx > -1) pendingAnimals.splice(idx, 1);
          });
      }
    }

