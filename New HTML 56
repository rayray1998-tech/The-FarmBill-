      animateLimbs(time, isMoving) {
          if(this.limbs.length === 4) {
              if(isMoving) {
                  const swing = Math.sin(time * 12) * 0.6;
                  this.limbs[0].rotation.x = swing;
                  if(this.charType !== 'bobet') this.limbs[1].rotation.x = -swing;
                  this.limbs[2].rotation.x = -swing;
                  this.limbs[3].rotation.x = swing;
              } else {
                  this.limbs[0].rotation.x = 0;
                  if(this.charType !== 'bobet') this.limbs[1].rotation.x = 0;
                  this.limbs[2].rotation.x = 0;
                  this.limbs[3].rotation.x = 0;
              }
          }
      }
      
      update(delta, time) {
        if (this.mixer) this.mixer.update(delta);

        if (statsData.energy <= 0 && this.id === 0) { 
            if (this.state !== 'RESTING') { 
                this.state = 'MOVING'; this.targetType = 'HOUSE'; this.targetObj = null; 
            } 
        } else if (this.state === 'RESTING') { 
            this.state = 'IDLE'; 
        }

        if (this.state === 'IDLE') {
          this.animateLimbs(time, false);
          const readyCrop = crops.find(c => c.scale >= 1.0 && !c.isDead && c.targetedBy === null);
          const drop = drops.find(d => d.targetedBy === null);
          const cow = animals.find(a => a.type === 'ANIM_Cow' && a.readyToMilk && a.targetedBy === null);
          
          if (readyCrop) { 
              readyCrop.targetedBy = this.id;
              this.targetObj = readyCrop; this.targetType = 'CROP'; this.state = 'MOVING'; 
          } 
          else if (drop) { 
              drop.targetedBy = this.id;
              this.targetObj = drop; this.targetType = 'DROP'; this.state = 'MOVING'; 
          } 
          else if (cow) { 
              cow.targetedBy = this.id;
              this.targetObj = cow; this.targetType = 'COW'; this.state = 'MOVING'; 
          } else {
              this.targetType = 'HOUSE'; this.state = 'MOVING';
          }
        } else if (this.state === 'MOVING') {
          this.animateLimbs(time, true);
          let targetPos;
          
          if (this.targetType === 'HOUSE') {
              const hX = Math.floor(GRID_SIZE/2) - Math.floor(GRID_SIZE/2) + 0.5 + ((this.id - 2) * 0.5);
              const hZ = Math.floor(GRID_SIZE/2) - Math.floor(GRID_SIZE/2) + 2.0 + (this.id % 2 === 0 ? 0.3 : -0.3); 
              targetPos = new THREE.Vector3(hX, 0, hZ); 
          }
          else if (this.targetType === 'CROP') { 
              if(!crops.includes(this.targetObj) || this.targetObj.isDead) { this.state = 'IDLE'; return; } 
              targetPos = this.targetObj.group.position; 
          } 
          else if (this.targetType === 'DROP') { 
              if(!drops.includes(this.targetObj)) { this.state = 'IDLE'; return; } 
              targetPos = this.targetObj.mesh.position; 
          } 
          else if (this.targetType === 'COW') { 
              if(!animals.includes(this.targetObj) || !this.targetObj.readyToMilk) { this.state = 'IDLE'; return; } 
              targetPos = this.targetObj.mesh.position; 
          } 
          else { this.state = 'IDLE'; return; }
          
          const dir = new THREE.Vector3(targetPos.x, 0, targetPos.z).sub(new THREE.Vector3(this.group.position.x, 0, this.group.position.z));
          const dist = dir.length();
          
          if (this.targetType === 'HOUSE' && dist < 0.6) { 
              this.state = 'RESTING'; this.animateLimbs(time, false); this.group.rotation.y = Math.PI; return; 
          }

          if (this.targetType !== 'HOUSE' && dist < 0.5) { 
              this.state = 'HARVESTING'; this.harvestTimer = (this.targetType === 'COW') ? 2.0 : 1.0; 
          } else { 
              const targetAngle = Math.atan2(dir.x, dir.z); const rotDiff = targetAngle - this.group.rotation.y; 
              this.group.rotation.y += Math.atan2(Math.sin(rotDiff), Math.cos(rotDiff)) * 10 * delta; dir.normalize(); 
              this.group.position.add(dir.multiplyScalar(this.speed * delta)); this.group.position.y = Math.abs(Math.sin(time * 15)) * 0.08; 
          }
        } else if (this.state === 'HARVESTING') {
          this.animateLimbs(time, false);
          this.harvestTimer -= delta;
          if (this.harvestTimer <= 0) {
            if (this.id === 0 && statsData.energy < 1) { 
                showNotification("Out of Energy!", "#ff4433"); 
                if(this.targetObj) this.targetObj.targetedBy = null;
                this.state = 'IDLE'; this.targetObj = null; return; 
            }
            if(this.id === 0) statsData.energy -= 1; // Only main player consumes energy
            
            if (this.targetType === 'CROP' && this.targetObj && crops.includes(this.targetObj)) {
              const conf = ITEM_CONFIG[this.targetObj.type] || { reward: 15 };
              let posX = this.targetObj.group.position.x; let posZ = this.targetObj.group.position.z;
              let cropName = this.targetObj.type.replace('CROP_', '').toLowerCase();
              processQuestProgress('harvest_crop', 1); processQuestProgress('harvest_' + cropName, 1);
              
              if(!statsData.inventory) statsData.inventory = {};
              let cropInvName = this.targetObj.type.replace('CROP_', '');
              statsData.inventory[cropInvName] = (statsData.inventory[cropInvName] || 0) + 1;
              
              this.targetObj.destroy(); crops.splice(crops.indexOf(this.targetObj), 1); farmGrid[this.targetObj.col][this.targetObj.row] = 0;
              statsData.coins += conf.reward; addXP(10); showFloatingText(`+${conf.reward} 🪙`, '#ffe680', posX, posZ); 
              spawnDust(posX, posZ); playSound('pop');
              
            } else if (this.targetType === 'DROP' && this.targetObj && drops.includes(this.targetObj)) {
              let reward = this.targetObj.type === 'EGG' ? 15 : 50;
              let posX = this.targetObj.mesh.position.x; let posZ = this.targetObj.mesh.position.z;
              if(this.targetObj.type === 'EGG') processQuestProgress('collect_egg', 1);
              
              scene.remove(this.targetObj.mesh); drops.splice(drops.indexOf(this.targetObj), 1);
              statsData.coins += reward; addXP(10); showFloatingText(`+${reward} 🪙`, '#ffe680', posX, posZ); 
              spawnDust(posX, posZ); playSound('pop');
              
            } else if (this.targetType === 'COW' && this.targetObj && animals.includes(this.targetObj)) {
              this.targetObj.lastProductTime = time; this.targetObj.readyToMilk = false;
              this.targetObj.targetedBy = null;
              statsData.coins += 80; addXP(10); showFloatingText(`+80 🪙`, '#ffe680', this.targetObj.mesh.position.x, this.targetObj.mesh.position.z); playSound('pop');
            }
            
            updateHUD(); syncDirty = true; this.state = 'IDLE'; this.targetObj = null;
          }
        }
      }
    }

