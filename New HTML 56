        GRID_SIZE = 36;
        statsData.gridSize = 36;
        farmGrid = Array.from({ length: GRID_SIZE }, () => Array(GRID_SIZE).fill(0));
        
        let offset = 6; // (36 - 24) / 2
        for(let c = 0; c < 24; c++) {
            for(let r = 0; r < 24; r++) {
                farmGrid[c + offset][r + offset] = oldGrid[c][r];
            }
        }
        
        farmBase.geometry.dispose();
        farmBase.geometry = new THREE.PlaneGeometry(GRID_SIZE, GRID_SIZE);
        gridHelper.geometry.dispose();
        scene.remove(gridHelper);
        gridHelper = new THREE.GridHelper(GRID_SIZE, GRID_SIZE, 0x000000, 0x000000);
        gridHelper.position.y = 0.01; 
        gridHelper.material.opacity = 0.2; 
        gridHelper.material.transparent = true; 
        gridHelper.visible = false; 
        scene.add(gridHelper);

        let shiftX = (36/2) - (24/2);
        let shiftZ = (36/2) - (24/2);

        crops.forEach(c => { c.col += offset; c.row += offset; c.group.position.x += shiftX; c.group.position.z += shiftZ; });
        buildings.forEach(b => { b.col += offset; b.row += offset; b.group.position.x += shiftX; b.group.position.z += shiftZ; });
        decorations.forEach(d => { d.col += offset; d.row += offset; d.group.position.x += shiftX; d.group.position.z += shiftZ; });
        animals.forEach(a => { 
            a.col += offset; a.row += offset; 
            a.mesh.position.x += shiftX; a.mesh.position.z += shiftZ; 
            a.targetX += shiftX; a.targetZ += shiftZ;
        });
        
        if (currentHouseMesh) {
            currentHouseMesh.position.x += shiftX;
            currentHouseMesh.position.z += shiftZ;
        }

        activeWorkers.forEach(w => {
            w.group.position.x += shiftX;
            w.group.position.z += shiftZ;
        });
        
        syncDirty = true;
    }

